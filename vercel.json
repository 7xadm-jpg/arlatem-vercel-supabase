{
  "redirects": [
    {
      "source": "/categoria/:slug.html",
      "destination": "/:slug/",
      "permanent": true
    },
    {
      "source": "/categoria/:slug",
      "destination": "/:slug/",
      "permanent": true
    },
    {
      "source": "/categoria/:slug/",
      "destination": "/:slug/",
      "permanent": true
    },
    {
      "source": "/bombas-arla.html",
      "destination": "/bombas-arla/",
      "permanent": true
    },
    {
      "source": "/sensores-nox.html",
      "destination": "/sensores-nox/",
      "permanent": true
    },
    {
      "source": "/catalisadores.html",
      "destination": "/catalisadores/",
      "permanent": true
    },
    {
      "source": "/dosadores.html",
      "destination": "/dosadores/",
      "permanent": true
    },
    {
      "source": "/filtros.html",
      "destination": "/filtros/",
      "permanent": true
    },
    {
      "source": "/modulos.html",
      "destination": "/modulos/",
      "permanent": true
    },
    {
      "source": "/chicotes.html",
      "destination": "/chicotes/",
      "permanent": true
    },
    {
      "source": "/reservatorios.html",
      "destination": "/reservatorios/",
      "permanent": true
    },
    {
      "source": "/tubulacoes.html",
      "destination": "/tubulacoes/",
      "permanent": true
    },
    {
      "source": "/pecas-pneumaticas.html",
      "destination": "/pecas-pneumaticas/",
      "permanent": true
    },
    {
      "source": "/kits-de-reparo.html",
      "destination": "/kits-de-reparo/",
      "permanent": true
    },
    {
      "source": "/acessorios.html",
      "destination": "/acessorios/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/catalogo/",
      "destination": "/catalogo.html"
    },
    {
      "source": "/acesso-tecnico-arlatem",
      "destination": "/admin.html"
    },
    {
      "source": "/catalogo.html",
      "has": [
        {
          "type": "query",
          "key": "categoria"
        }
      ],
      "destination": "/api/legacy-category-redirect"
    },
    {
      "source": "/catalogo.html",
      "has": [
        {
          "type": "query",
          "key": "categoriaSlug"
        }
      ],
      "destination": "/api/legacy-category-redirect"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/acesso-tecnico-arlatem",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/catalogo.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    }
  ]
}
